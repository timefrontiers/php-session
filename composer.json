{
  "name": "timefrontiers/php-session",
  "description": "Modern PHP session manager with authentication state, access control, and CSRF protection",
  "keywords": ["php", "session", "manager", "security", "csrf", "authentication", "access-control"],
  "homepage": "https://github.com/timefrontiers/php-session",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Ikechukwu Okalia",
      "email": "consult@ikechukwuokalia.dev",
      "homepage": "https://ikechukwuokalia.dev",
      "role": "developer"
    },
    {
      "name": "Time Frontiers Ltd",
      "email": "git@timefrontiers.com",
      "homepage": "https://git.timefrontiers.com",
      "role": "developer"
    }
  ],
  "require": {
    "php": ">=8.5",
    "psr/log": "^3.0",
    "timefrontiers/php-core": "^1.0",
    "timefrontiers/php-has-errors": "^1.0"
  },
  "require-dev": {
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5"
  },
  "suggest": {
    "ext-redis": "For Redis session storage",
    "timefrontiers/php-instance-error": "For rank-filtered presentation of canonical error tuples",
    "timefrontiers/php-location": "For optional IP geolocation support"
  },
  "autoload": {
    "psr-4": {
      "TimeFrontiers\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TimeFrontiers\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G --no-progress",
    "check": [
      "@lint",
      "@test",
      "@analyse"
    ],
    "lint": "@php vendor/bin/parallel-lint src tests",
    "test": "@php vendor/bin/phpunit --configuration=phpunit.xml.dist --fail-on-warning --fail-on-risky --fail-on-deprecation --fail-on-notice"
  },
  "config": {
    "sort-packages": true
  }
}
